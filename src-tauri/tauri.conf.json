{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Win RDP Next",
  "version": "0.7.4",
  "identifier": "io.winrdp.Next",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Win RDP Next", "width": 480, "height": 600,
      "minWidth": 460, "minHeight": 420, "decorations": false, "resizable": true,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
