+/* WinRDP private patch: winrdp-hwdecode-1. Hardware decoding is opt-in. */
+#ifdef WITH_VAAPI
+static BOOL winrdp_try_decoder(H264_CONTEXT* h264, enum AVHWDeviceType type,
+                               enum AVPixelFormat format, const char* device)
+{
+    H264_CONTEXT_LIBAVCODEC* sys = (H264_CONTEXT_LIBAVCODEC*)h264->pSystemData;
+    BOOL supported = FALSE;
+    for (int i = 0; ; ++i)
+    {
+        const AVCodecHWConfig* config = avcodec_get_hw_config(sys->codecDecoder, i);
+        if (!config) break;
+        if ((config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) &&
+            config->device_type == type && config->pix_fmt == format)
+        { supported = TRUE; break; }
+    }
+    if (!supported) return FALSE;
+    const int rc = av_hwdevice_ctx_create(&sys->hwctx, type, device, nullptr, 0);
+    if (rc < 0)
+    {
+        av_buffer_unref(&sys->hwctx);
+        return FALSE;
+    }
+    sys->codecDecoderContext->hw_device_ctx = av_buffer_ref(sys->hwctx);
+    if (!sys->codecDecoderContext->hw_device_ctx)
+    { av_buffer_unref(&sys->hwctx); return FALSE; }
+    sys->hwFrameSupportsNativeFormat = -1;
+    sys->hw_pix_fmt = format;
+    sys->codecDecoderContext->get_format = libavcodec_get_format;
+    sys->codecDecoderContext->opaque = (void*)h264;
+    WLog_Print(h264->log, WLOG_INFO, "WinRDP H264: initialized %s device %s (awaiting decoded frame)",
+               av_hwdevice_get_type_name(type), device ? device : "default");
+    return TRUE;
+}
+static void winrdp_select_decoder(H264_CONTEXT* h264)
+{
+    const char* mode = getenv("WINRDP_HWDECODER");
+    if (!mode || strcmp(mode,"software") == 0) return;
+    const BOOL automatic = strcmp(mode,"auto") == 0;
+    if ((automatic || strcmp(mode,"cuda") == 0) &&
+        winrdp_try_decoder(h264,AV_HWDEVICE_TYPE_CUDA,AV_PIX_FMT_CUDA,
+                           getenv("WINRDP_CUDA_DEVICE"))) return;
+    if (automatic || strcmp(mode,"vaapi") == 0)
+    {
+        const char* explicitDevice = getenv("FREERDP_VAAPI_DEVICE");
+        if (explicitDevice && explicitDevice[0])
+        {
+            if (winrdp_try_decoder(h264,AV_HWDEVICE_TYPE_VAAPI,AV_PIX_FMT_VAAPI,explicitDevice)) return;
+        }
+        else
+        {
+            /* Enumerate render nodes rather than assuming the usable GPU is 128. */
+            for (int node = 128; node < 144; ++node)
+            {
+                char path[64] = {0};
+                (void)snprintf(path,sizeof(path),"/dev/dri/renderD%d",node);
+                if (winrdp_try_decoder(h264,AV_HWDEVICE_TYPE_VAAPI,AV_PIX_FMT_VAAPI,path)) return;
+            }
+        }
+    }
+    WLog_Print(h264->log,WLOG_WARN,"WinRDP H264: no requested hardware device initialized; using software FFmpeg");
+}
